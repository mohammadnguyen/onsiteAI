# SiteTracker mobile (Expo) — env example.
#
# Copy to .env (gitignored) for local development. The two vars below
# are read by mobile/app.config.ts at build/dev-server time.
#
# !! SECURITY !!
# EXPO_PUBLIC_-prefixed variables are baked into the JavaScript bundle
# and are visible to anyone with the IPA / APK. Do NOT put secrets
# (JWT secrets, API keys, OAuth client secrets) in any EXPO_PUBLIC_*
# variable. API URLs are fine; auth happens at runtime via JWT.

# Backend API base URL. Include scheme; no trailing slash.
#   - Local same-machine sim:   http://127.0.0.1:8000
#   - LAN-tested physical phone: http://192.168.x.x:8000   (match your dev box)
#   - Staging / production:     https://api.example.com
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Expo dev-server bind address. Set this to the same LAN IP as
# EXPO_PUBLIC_API_URL when running on a physical iPhone over Wi-Fi so
# the Metro bundler is reachable from the device. Not needed for
# simulator-only development.
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.x.x
