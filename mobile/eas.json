{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sitetracker-backend-staging.fly.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sitetracker-backend-staging.fly.dev"
      }
    },
    "test": {
      "autoIncrement": true,
      "env": {
        "FOREY_VARIANT": "test",
        "EXPO_PUBLIC_API_URL": "https://forey-test-api.fly.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "W58T3X33VM",
        "ascAppId": "6799641228"
      }
    },
    "test": {
      "ios": {
        "appleTeamId": "W58T3X33VM",
        "ascAppId": "6813764247"
      }
    }
  }
}
