# Host port 5433 avoids clashing with a native Postgres on 5432 (common on
# Windows dev machines). Inside Docker Compose the backend reaches Postgres
# on the internal hostname db:5432 — only the host-side port is 5433.
DATABASE_URL=postgresql+asyncpg://sitetracker:sitetracker@localhost:5433/sitetracker
JWT_SECRET=change-me-in-prod
ENVIRONMENT=development
