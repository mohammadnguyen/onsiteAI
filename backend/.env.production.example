# SiteTracker backend — PRODUCTION environment example.
#
# Copy to .env.production (gitignored) on the production host only and
# replace every <REPLACE-...> placeholder. The non-development
# validator refuses to start the app with any placeholder value left
# in place.
#
# Production-specific operational rules:
#   - Restrict file permissions: chmod 600 .env.production
#   - File owner = the process user; not world-readable.
#   - Rotate JWT_SECRET on a documented schedule (handbook).
#   - Never commit, never email, never paste in chat. Use the
#     hosting-provider secret store or a dedicated secrets manager
#     when one is introduced (future ADR).
#
# Rotation procedure: docs/operations/env-and-secrets.md.

APP_ENV=production

# Production database connection string. Use SSL where supported.
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>

# 32+ char secret. Generate with: ``python -c "import secrets;
# print(secrets.token_urlsafe(64))"``. Never reuse the staging secret.
JWT_SECRET=<REPLACE-WITH-A-RANDOM-SECRET-OF-AT-LEAST-32-CHARS>

# Explicit comma-separated list of allowed origins. Wildcard "*" is
# rejected outside development. Include scheme; do not include a
# trailing slash. Trailing-slash mismatches are a common CORS
# misconfiguration in production.
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com

# Attachment storage (Tigris, S3-compatible) — required in every
# non-development environment; the validator refuses to start without
# all four. On Fly, `fly storage create` injects these as app secrets
# with exactly these names (run it BEFORE deploying PR 6 or newer).
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
BUCKET_NAME=<REPLACE-WITH-BUCKET-NAME>
AWS_ACCESS_KEY_ID=<REPLACE-WITH-TIGRIS-ACCESS-KEY>
AWS_SECRET_ACCESS_KEY=<REPLACE-WITH-TIGRIS-SECRET-KEY>
