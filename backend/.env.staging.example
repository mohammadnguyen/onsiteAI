# SiteTracker backend — STAGING environment example.
#
# Copy to .env.staging (gitignored) and replace every <REPLACE-...>
# placeholder before starting the process. The non-development
# validator refuses to start the app with any placeholder value left
# in place.
#
# Rotation procedure: docs/operations/env-and-secrets.md.

APP_ENV=staging

# Connection string for the staging database. Use a dedicated DB; do
# not point staging at a production cluster.
#
# On Fly.io (per ADR 0003): DATABASE_URL is auto-injected by
# `fly mpg attach <CLUSTER_ID>` and must NOT be set manually as a
# Fly secret. See docs/operations/staging-deploy.md Gate D-4 and
# docs/operations/env-and-secrets.md.
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>

# 32+ char secret. Generate with: ``python -c "import secrets;
# print(secrets.token_urlsafe(64))"``. Never reuse the production
# secret. Rotate at least quarterly per the ops handbook.
JWT_SECRET=<REPLACE-WITH-A-RANDOM-SECRET-OF-AT-LEAST-32-CHARS>

# Explicit comma-separated list of allowed origins. Wildcard "*" is
# rejected outside development. Include scheme; do not include a
# trailing slash.
CORS_ALLOWED_ORIGINS=https://admin.staging.example.com,https://app.staging.example.com
