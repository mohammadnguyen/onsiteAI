# SiteTracker backend — TEST environment example.
#
# Copy to .env.test (gitignored) only if you want a file-based test
# config. Tests do not require this file: backend/tests/conftest.py
# pre-seeds APP_ENV=test, DATABASE_URL, JWT_SECRET, and
# CORS_ALLOWED_ORIGINS via os.environ.setdefault before any
# ``app.config`` import.
#
# This example exists for parity with the other environments and as
# documentation of what tests effectively run with.

APP_ENV=test

# Dedicated test database (must already exist; created once per fresh
# Docker volume via: CREATE DATABASE sitetracker_test OWNER sitetracker).
# Tests roll back each transaction, so the live DB is never touched.
DATABASE_URL=postgresql+asyncpg://sitetracker:sitetracker@localhost:5433/sitetracker_test

# Non-placeholder, >= 32 chars — passes the non-dev validator. Same
# value the conftest seeds by default.
JWT_SECRET=test-secret-for-sitetracker-phase1-never-production

# Test environment is treated as non-development by the validator, so
# CORS must be a non-empty, non-wildcard list. A throwaway value is
# fine for ASGI-transport tests where no real CORS check happens.
CORS_ALLOWED_ORIGINS=https://localhost.test

# Attachment storage — test env is non-dev so the four vars are
# required; conftest.py pre-seeds these fake values (storage tests
# mock boto3, nothing reaches a real bucket).
AWS_ENDPOINT_URL_S3=https://storage.test.invalid
BUCKET_NAME=sitetracker-test-bucket
AWS_ACCESS_KEY_ID=test-storage-access-key
AWS_SECRET_ACCESS_KEY=test-storage-secret-key-never-real
