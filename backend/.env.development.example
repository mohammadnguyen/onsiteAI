# SiteTracker backend — DEVELOPMENT environment example.
#
# Copy to .env.development (gitignored) and edit if your local setup
# differs. The dev environment is intentionally permissive: placeholder
# secrets and wildcard CORS are allowed so a fresh clone "just works"
# after the cp step.
#
# Production gates documented in docs/operations/env-and-secrets.md.

# Canonical environment selector. Do NOT also set ENVIRONMENT.
APP_ENV=development

# Host port 5433 avoids clashing with a native Postgres on 5432 (common
# on Windows dev machines). Inside Docker Compose the backend reaches
# Postgres on the internal hostname db:5432 — only the host-side port
# is 5433.
DATABASE_URL=postgresql+asyncpg://sitetracker:sitetracker@localhost:5433/sitetracker

# Dev-only placeholder. Validator allows this exact value ONLY when
# APP_ENV=development. Replace before promoting to any other env.
JWT_SECRET=change-me-in-prod

# Comma-separated list. "*" is allowed in development only.
CORS_ALLOWED_ORIGINS=*

# Attachment storage (OPTIONAL in development). Leave unset to boot
# without a bucket — attachment endpoints then return 503 via
# StorageNotConfigured. Set all four to test against a real Tigris
# bucket (`fly storage create` output).
#AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
#BUCKET_NAME=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
