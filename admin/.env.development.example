# SiteTracker admin — development mode.
#
# Copy to .env.development (gitignored). Vite picks this up
# automatically when running `npm run dev` or `npm run build` without
# an explicit --mode flag.
#
# If the local backend listens on a different host/port (e.g. LAN IP
# for mobile-device testing), override here:
#   VITE_API_URL=http://192.168.x.x:8000
VITE_API_URL=http://127.0.0.1:8000
