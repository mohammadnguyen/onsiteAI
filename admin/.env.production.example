# SiteTracker admin — production mode.
#
# Copy to .env.production (gitignored) on the build host before running
#   npm run build -- --mode production
#
# VITE_API_URL is baked into the JS bundle at build time. It is NOT a
# secret (it's visible in every network call from the browser), but any
# typo (wrong host, wrong scheme, trailing slash) breaks the deployed
# admin site without obvious server-side symptoms. Verify in the
# browser network tab on first deploy.
VITE_API_URL=https://<REPLACE-WITH-BACKEND-HTTPS-ORIGIN>
