# SiteTracker admin (Vite) — env file index.
#
# Vite loads .env.[mode] automatically based on the build mode:
#   npm run dev                       → .env.development
#   npm run build                     → .env.production
#   npm run build -- --mode staging   → .env.staging
#
# Concrete files (.env.development, .env.local, .env.production) are
# gitignored. Only .example files are committed. Pick the example that
# matches the mode and copy:
#
#   cp .env.development.example .env.development
#   cp .env.production.example  .env.production
#
# VITE_API_URL must include scheme; do not include a trailing slash.
# Anything baked into a VITE_-prefixed var ships inside the JS bundle —
# do not put secrets here.
VITE_API_URL=http://127.0.0.1:8000
