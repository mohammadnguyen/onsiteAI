# EditorConfig — https://editorconfig.org
# Top-level config for the SiteTracker V1 monorepo.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python — 4-space indent per PEP 8
[*.py]
indent_size = 4

# TypeScript / JavaScript / JSON / YAML — 2-space
[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,yml,yaml}]
indent_size = 2

# Markdown — 2-space; preserve trailing whitespace (used for line breaks)
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Makefiles require literal tabs
[Makefile]
indent_style = tab

# Batch files — Windows CRLF
[*.{bat,cmd}]
end_of_line = crlf
